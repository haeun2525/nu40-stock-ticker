# ─────────────────────────────────────────────────────────────
# NU40 DK 주식 티커 설정 파일 (예시)
#
# 이 파일을 복사해서 같은 폴더에 ".env" 라는 이름으로 저장한 뒤 값을 채우세요.
#   맥/리눅스:  cp host/config.example.env host/.env
#   윈도우:     copy host\config.example.env host\.env
#
# .env 는 .gitignore 에 들어 있어서 깃에 올라가지 않습니다.
# 여기 적는 키는 남에게 보여주면 안 됩니다.
# ─────────────────────────────────────────────────────────────

# 토스증권 WTS → 설정 → Open API 에서 발급받은 값
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 보드가 연결된 시리얼 포트
#   윈도우 예:  COM3
#   맥 예:      /dev/cu.usbmodem1101
#   비워두면 프로그램이 알아서 찾습니다.
SERIAL_PORT=/dev/cu.usbmodem1101

# 몇 초마다 시세를 가져올지 (최소 1초, 기본 5초)
POLL_SECONDS=5

# 슬롯 설정:  SLOTn = 종목코드,표시이름,임계가
#   - 슬롯 0~3 은 보드의 버튼 1~4 에 각각 대응합니다.
#   - 국내 종목은 6자리 숫자(005930), 미국 종목은 영문 티커(TSLA)를 씁니다.
#   - 임계가: 현재가가 이 값 아래로 내려가면 해당 슬롯의 LED가 켜집니다.
#   - 표시이름에 한글을 쓰면 OLED에는 종목코드가 대신 나옵니다.
#     (화면 기본 글꼴에 한글이 없어서 한글을 그리면 글자가 깨집니다)
SLOT0=005930,삼성전자,69000
SLOT1=000660,SK하이닉스,170000
SLOT2=TSLA,테슬라,400
SLOT3=NVDA,엔비디아,170

# 차트에 담을 범위
#   day  = 오늘 장 전체 (09:00~현재)  ← 기본값
#   hour = 최근 64분 (움직임이 훨씬 크게 보입니다)
CHART_RANGE=day
