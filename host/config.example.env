# ─────────────────────────────────────────────────────────────
# NU40 DK stock ticker settings (example)
#
# Copy this file to ".env" in the same folder, then fill in the values.
#   macOS/Linux:  cp host/config.example.env host/.env
#   Windows:      copy host\config.example.env host\.env
#
# .env is listed in .gitignore, so it never gets committed.
# Don't show the keys you put here to anyone.
# ─────────────────────────────────────────────────────────────

# From Toss Securities WTS → Settings → Open API
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Serial port the board is on
#   Windows example:  COM3
#   Mac example:      /dev/cu.usbmodem1101
#   Leave it empty and the program finds it for you.
SERIAL_PORT=/dev/cu.usbmodem1101

# How often to fetch prices, in seconds (minimum 1, default 5)
POLL_SECONDS=5

# Slots:  SLOTn = symbol,display name,alert level
#   - Slots 0-3 match the board's buttons 1-4.
#   - Korean stocks use a 6-digit code (005930); US stocks use the ticker (TSLA).
#   - Alert level: when the price drops below it, that slot's LED turns on.
#   - Display names can be English or Korean. Korean is drawn with the built-in
#     Hangul pixel font (firmware/nu40_ticker/hangul_font.h).
#   - Names are cut at 80 pixels (about 13 English letters or 8 Korean characters).
SLOT0=AAPL,Apple,180
SLOT1=NVDA,Nvidia,170
SLOT2=TSLA,Tesla,400
SLOT3=MSFT,Microsoft,400
# Korean example (names are drawn with the built-in Hangul font):
# SLOT0=005930,삼성전자,69000
# SLOT1=000660,SK하이닉스,170000
# SLOT2=TSLA,테슬라,400
# SLOT3=NVDA,엔비디아,170

# Chart range
#   day  = today's whole session (open to now)  ← default
#   hour = last 64 minutes (movement looks much bigger)
CHART_RANGE=day
